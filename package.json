{
  "name": "industrial-tech-marketplace",
  "private": true,
  "description": "Industrial technician discovery marketplace (Hyderabad). Technology platform only — see docs/business-model.md.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:admin": "npm run dev -w admin",
    "dev:mobile": "npm run start -w mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "guard": "vitest run scripts/guards",
    "build:web": "npm run build -w web",
    "build:admin": "npm run build -w admin",
    "check": "npm run guard && npm run typecheck && npm test",
    "db:types": "supabase gen types typescript --linked --schema public > packages/types/src/database.generated.ts",
    "catalogue:build": "node scripts/catalogue/build-seed.mjs",
    "demo": "node scripts/demo/server.mjs",
    "demo:reset": "node scripts/demo/server.mjs --reset",
    "demo:env": "node scripts/demo/env.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "typescript": "^5",
    "vitest": "4.1.12",
    "@types/node": "22.20.5"
  },
  "engines": {
    "node": ">=22"
  }
}
